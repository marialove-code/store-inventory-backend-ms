<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inventory.modules.system.log.mapper.SysLoginLogMapper">

    <resultMap id="BaseResultMap" type="com.inventory.modules.system.log.entity.SysLoginLog">
        <id property="id" column="id" />
        <result property="userId" column="user_id" />
        <result property="userName" column="user_name" />
        <result property="nickName" column="nick_name" />
        <result property="loginIp" column="login_ip" />
        <result property="loginAddress" column="login_address" />
        <result property="browser" column="browser" />
        <result property="operatingSystem" column="operating_system" />
        <result property="loginStatus" column="login_status" />
        <result property="failReason" column="fail_reason" />
        <result property="userAgent" column="user_agent" />
        <result property="loginTime" column="login_time" />
        <result property="createdTime" column="created_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id,user_id,user_name,nick_name,login_ip,login_address,
        browser,operating_system,login_status,fail_reason,user_agent,
        login_time,created_time
    </sql>


    <select id="selectLatestSuccessLog" resultType="com.inventory.modules.system.log.entity.SysLoginLog">
        SELECT * FROM sys_login_log
        WHERE user_id = #{userId} AND login_status = 1
        ORDER BY login_time DESC LIMIT 1
    </select>

    <select id="selectRecentLogs" resultType="com.inventory.modules.system.log.entity.SysLoginLog">
        SELECT * FROM sys_login_log
        WHERE user_id = #{userId}
        ORDER BY login_time DESC LIMIT #{limit}
    </select>

</mapper>