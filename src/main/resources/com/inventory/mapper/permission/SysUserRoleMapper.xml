<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inventory.mapper.SysUserRoleMapper">

    <resultMap id="BaseResultMap" type="com.inventory.entity.SysUserRole">
            <id property="id" column="id" />
            <result property="userId" column="user_id" />
            <result property="roleId" column="role_id" />
    </resultMap>

    <sql id="Base_Column_List">
        id,user_id,role_id
    </sql>


    <!--批量插入用户角色关联关系-->
    <insert id="batchInsert">
        INSERT INTO sys_user_role (id,user_id, role_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id},#{item.userId}, #{item.roleId})
        </foreach>
    </insert>


    <!--
       功能：根据角色ID查询关联的用户ID
       表：sys_user_role
       用途：删除/禁用角色时，拿到用户ID → 踢下线、删token
   -->
    <select id="selectUserIdsByRoleId" resultType="java.lang.Long">
        SELECT user_id
        FROM sys_user_role
        WHERE role_id = #{roleId}
    </select>


    <select id="countByRoleId" resultType="java.lang.Long">
        SELECT COUNT(*) FROM sys_user_role WHERE role_id = #{roleId}
    </select>
</mapper>
