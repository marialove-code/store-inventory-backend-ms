<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inventory.mapper.SysPermissionMapper">

    <resultMap id="BaseResultMap" type="com.inventory.entity.SysPermission">
            <id property="id" column="id" />
            <result property="parentId" column="parent_id" />
            <result property="permName" column="perm_name" />
            <result property="permType" column="perm_type" />
            <result property="path" column="path" />
            <result property="component" column="component" />
            <result property="permCode" column="perm_code" />
            <result property="icon" column="icon" />
            <result property="sort" column="sort" />
            <result property="status" column="status" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
            <result property="isDeleted" column="is_deleted" />
    </resultMap>

    <sql id="Base_Column_List">
        id,parent_id,perm_name,perm_type,path,component,
        perm_code,icon,sort,status,create_time,
        update_time,is_deleted
    </sql>


    <!-- 根据用户ID查询权限标识列表 -->
    <select id="listPermCodesByUserId" resultType="java.lang.String">
        SELECT DISTINCT p.perm_code
        FROM sys_user u
                 JOIN sys_user_role ur ON u.id = ur.user_id
                 JOIN sys_role_permission rp ON ur.role_id = rp.role_id
                 JOIN sys_permission p ON rp.perm_id = p.id
        WHERE u.id = #{userId}
          AND p.is_deleted = 0
          AND p.status = 1
    </select>


    <!-- 根据用户ID查询菜单列表（前端侧边栏用） -->
    <select id="listUserPermissions" resultType="com.inventory.entity.SysPermission">
        SELECT DISTINCT
            p.id,
            p.parent_id,
            p.menu_name,
            p.menu_type,
            p.path,
            p.component,
            p.perms,
            p.icon,
            p.sort
        FROM sys_permission p
                 LEFT JOIN sys_role_permission rp ON p.id = rp.perm_id
                 LEFT JOIN sys_user_role ur ON rp.role_id = ur.role_id
        WHERE ur.user_id = #{userId}
          AND p.menu_type IN ('M', 'C')
          AND p.status = 1
          AND p.is_deleted = 0
        ORDER BY p.sort
    </select>

</mapper>
