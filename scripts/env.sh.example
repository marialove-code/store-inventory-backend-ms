#!/bin/sh
# 复制到服务器：/opt/inventory-ms/env.sh
#   cp env.sh.example /opt/inventory-ms/env.sh
#   chmod 600 /opt/inventory-ms/env.sh
# 再编辑填入真实密码。此文件不要提交真实密码到 Git。

export JAVA_HOME=/www/server/java/jdk-17.0.8
# 必须带上 /usr/bin，否则 source 后会出现 mkdir/ss: command not found
export PATH=$JAVA_HOME/bin:/usr/local/bin:/usr/bin:/bin:$PATH

export SPRING_PROFILES_ACTIVE=prd
export DB_PWD='请改成数据库密码'
export REDIS_HOST=127.0.0.1
# 无密码：export REDIS_PWD=
export REDIS_PWD='请改成Redis密码'

# 通义/DashScope（ai-service 必填，否则起不来，Gateway 会 503）
# 阿里云百炼控制台申请：https://bailian.console.aliyun.com/
export DASHSCOPE_API_KEY='请改成你的sk-xxx'
