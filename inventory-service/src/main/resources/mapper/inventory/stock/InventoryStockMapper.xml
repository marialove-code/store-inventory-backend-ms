<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.inventory.modules.invertory.stock.mapper.InventoryStockMapper">

    <resultMap id="BaseResultMap" type="com.inventory.modules.invertory.stock.entity.InventoryStock">
            <id property="id" column="id" />
            <result property="goodsId" column="goods_id" />
            <result property="goodsName" column="goods_name" />
            <result property="categoryName" column="category_name" />
            <result property="stock" column="stock" />
            <result property="lockStock" column="lock_stock" />
            <result property="stockWarn" column="stock_warn" />
            <result property="stockStatus" column="stock_status" />
            <result property="sort" column="sort" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
            <result property="lastReceiptTime" column="last_receipt_time" />
            <result property="operateType" column="operate_type" />


    </resultMap>

    <sql id="Base_Column_List">
        id,goods_id,goods_name,category_name,stock,lock_stock,
        stock_warn,stock_status,sort,create_time,update_time,last_receipt_time,operate_type
    </sql>


    <!-- 库存总量（PG版） -->
    <select id="getTotalStock" resultType="java.lang.Integer">
        SELECT COALESCE(SUM(stock), 0)
        FROM inventory_stock
    </select>

    <!-- 库存预警数量（PG版 + XML转义） -->
    <select id="getWarnStockCount" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM inventory_stock
        WHERE stock &lt;= stock_warn
    </select>

    <!--
        V4 原子锁定库存（PostgreSQL）
        条件：可用库存 stock - lock_stock >= qty 才更新，否则影响行数为 0
        与 V1「先 SELECT 再判断再 UPDATE」不同，判断与更新在同一条 SQL 内完成
    -->
    <update id="lockStockIfAvailable">
        UPDATE inventory_stock
        SET lock_stock = lock_stock + #{qty},
            update_time = NOW()
        WHERE goods_id = #{goodsId}
          AND stock - COALESCE(lock_stock, 0) &gt;= #{qty}
    </update>
</mapper>
